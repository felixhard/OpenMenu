// Ad-hoc signing lets contributors build without an Apple Developer account.
// To use a local signing identity, create Config/Signing.local.xcconfig with:
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = YOURTEAMID

CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
